# Polygon RPC endpoint
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Polygon Amoy (testnet) RPC endpoint - use this network first, before Polygon mainnet
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployer wallet private key (DO NOT commit the real key!)
# Pays gas for the deployment transaction only - gets no role in the deployed
# contract, scripts/deploy-v3.js checks this after deploying.
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# Free API key from etherscan.io, used for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Required by scripts/deploy-v3.js (EarthlingPassportV3) ---

# Address that receives DEFAULT_ADMIN_ROLE - must be a Safe (multisig), separate
# from the treasury Safe. Threshold 1 for now, grows to 5-of-6 without changing
# the address.
V3_ADMIN_ADDRESS=0x_your_safe_admin_address_here

# Address that receives MINTER_ROLE - a plain wallet, only used for issuing
# passports. Its private key belongs in earthlings-kyc's own environment, not
# here. Must differ from V3_ADMIN_ADDRESS - the script refuses to deploy
# otherwise, since that would defeat the point of separating the roles.
V3_MINTER_ADDRESS=0x_your_minter_wallet_address_here

# Daily passport-issuance cap. Defaults to 100 if unset (decision of 2026-10-06: equal to
# the minimum base of one hundred confirmed participants, never above it).
V3_DAILY_MINT_LIMIT=100

# --- Used by scripts/amoy-rehearsal.js, check-v3.js, safe-calls.js ---
# Address of the V3 deployed on Amoy (printed by deploy-v3.js) and the test wallets of the
# rehearsal. Test keys only - never the production minter key.
V3_AMOY_ADDRESS=
AMOY_TEST_ADMIN_KEY=
AMOY_TEST_MINTER_KEY=
AMOY_TEST_MINTER2_KEY=
# Address of the V3 on Polygon for check-v3.js / safe-calls.js
V3_ADDRESS=
